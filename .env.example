# Credenciais do RetroAchievements
RA_USER=seu_usuario
RA_API_KEY=sua_chave_da_api

# Chave que assina o cookie de sessão (gere com: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# Senha de acesso ao app. Use o HASH (recomendado), entre aspas simples por causa dos "$":
#   python -c "from werkzeug.security import generate_password_hash as g; print(g(input('Senha: ')))"
APP_PASSWORD_HASH=''
# Alternativa mais simples (texto puro). Só vale se APP_PASSWORD_HASH estiver vazio:
# APP_PASSWORD=

# Coloque 1 se o app for servido por HTTPS (cookie só trafega em conexão segura)
COOKIE_SECURE=0

# Só para desenvolvimento local; nunca ligue em servidor exposto
# FLASK_DEBUG=1
